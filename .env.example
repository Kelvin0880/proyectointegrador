# Copia este archivo como ".env" (opcional: el proyecto funciona sin él con estos valores por defecto)

# Secreto para firmar las sesiones de NextAuth (cámbialo por cualquier texto largo)
NEXTAUTH_SECRET=unphuInventarioSecretKey
NEXTAUTH_URL=http://localhost:3000

# Ruta del archivo de base de datos SQLite (por defecto: database/unphu.db)
# DATABASE_FILE=database/unphu.db
